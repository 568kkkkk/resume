#!/bin/sh
# 安装：把本文件复制为 .git/hooks/pre-commit
#   cp scripts/pre-commit .git/hooks/pre-commit
# 作用：每次 git commit 前自动重新扫描素材文件夹，更新 assets/manifest.js 并加入本次提交，
#       这样「丢文件进文件夹 → commit → push」全自动生效（无需 node）。

echo "[pre-commit] 重新生成作品清单..."
ROOT="$(git rev-parse --show-toplevel)"
GEN="$ROOT/generate-manifest.sh"

if [ -f "$GEN" ] && command -v bash >/dev/null 2>&1; then
  if bash "$GEN" >/dev/null 2>&1; then
    git add assets/manifest.js
  else
    echo "[pre-commit] 警告：清单生成失败，已跳过（不影响本次提交）。"
  fi
elif [ -f "$ROOT/generate-manifest.js" ] && command -v node >/dev/null 2>&1; then
  if node "$ROOT/generate-manifest.js" >/dev/null 2>&1; then
    git add assets/manifest.js
  else
    echo "[pre-commit] 警告：清单生成失败，已跳过（不影响本次提交）。"
  fi
else
  echo "[pre-commit] 未检测到生成脚本/node，跳过清单生成（不影响本次提交）。"
fi
